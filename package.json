{
  "name": "whydunit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "generate": "node src/cli.ts generate",
    "features": "node src/cli.ts features",
    "train": ".venv/bin/python eval/train.py",
    "eval": ".venv/bin/python eval/evaluate.py",
    "policy": "node src/cli.ts policy",
    "all": "npm run generate && npm run features && npm run train && npm run eval && npm run report && npm run policy && npm run agent -- --fresh",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "agent": "node src/cli.ts agent",
    "report": "node src/cli.ts report"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "better-sqlite3": "^13.0.3"
  }
}
